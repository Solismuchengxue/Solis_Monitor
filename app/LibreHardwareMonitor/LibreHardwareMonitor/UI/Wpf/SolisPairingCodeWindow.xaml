<Window x:Class="LibreHardwareMonitor.UI.WpfViews.SolisPairingCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入配对码"
        Width="520"
        Height="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#101521"
        Foreground="#F5F8FC"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#F5F8FC" />
            <Setter Property="Background" Value="#172737" />
            <Setter Property="BorderBrush" Value="#4B6278" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#168DE2" />
            <Setter Property="BorderBrush" Value="#2CA4F5" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="28"
                       FontWeight="Bold"
                       Text="安全配对" />
            <TextBlock x:Name="DeviceNameText"
                       Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#A4AFBD" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="22"
                Background="#111F2C"
                BorderBrush="#2A3B4D"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="14"
                           Foreground="#D6DFE8"
                           Text="请输入副屏发现页面显示的 6 位数字配对码。" />
                <TextBox x:Name="PairingCodeInput"
                         Margin="0,16,0,0"
                         Height="54"
                         MaxLength="6"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas"
                         FontSize="28"
                         CharacterCasing="Upper"
                         Foreground="#F5F8FC"
                         Background="#172737"
                         BorderBrush="#4B6278"
                         BorderThickness="1"
                         CaretBrush="#F5F8FC"
                         PreviewTextInput="PairingCodeInput_PreviewTextInput"
                         TextChanged="PairingCodeInput_TextChanged" />
                <TextBlock x:Name="ValidationText"
                           Margin="0,10,0,0"
                           Foreground="#FF6775"
                           Text="请输入 6 位数字配对码。"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Style="{StaticResource ActionButtonStyle}"
                    IsCancel="True"
                    Content="取消" />
            <Button x:Name="ConfirmButton"
                    Margin="12,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="ConfirmButton_Click"
                    Content="确认配对" />
        </StackPanel>
    </Grid>
</Window>
