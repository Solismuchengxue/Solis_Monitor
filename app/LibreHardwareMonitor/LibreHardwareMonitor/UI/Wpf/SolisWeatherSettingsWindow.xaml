<Window x:Class="LibreHardwareMonitor.UI.WpfViews.SolisWeatherSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="天气设置"
        Width="700"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#101521"
        Foreground="#F5F8FC"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#F5F8FC" />
            <Setter Property="Background" Value="#172737" />
            <Setter Property="BorderBrush" Value="#3B4E62" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#F5F8FC" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#F5F8FC" />
            <Setter Property="Background" Value="#172737" />
            <Setter Property="BorderBrush" Value="#3B4E62" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#F5F8FC" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#F5F8FC" />
            <Setter Property="Background" Value="#172737" />
            <Setter Property="BorderBrush" Value="#4B6278" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#168DE2" />
            <Setter Property="BorderBrush" Value="#2CA4F5" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E6EDF5" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="30"
                       FontWeight="Bold"
                       Text="天气设置" />
            <TextBlock Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#A4AFBD"
                       Text="配置和风天气，并在保存前验证接口与位置。" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="22"
                Background="#111F2C"
                BorderBrush="#2A3B4D"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="API Host" />
                    <TextBox x:Name="ApiHostInput"
                             TextChanged="InputChanged" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="#8291A2"
                               Text="只填写域名，不包含 https:// 或路径。" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="API Key" />
                    <PasswordBox x:Name="ApiKeyInput"
                                 PasswordChanged="InputChanged" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="#8291A2"
                               Text="留空保留现有密钥。" />
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="经纬度（经度,纬度）" />
                        <Button DockPanel.Dock="Right"
                                Margin="12,-7,0,5"
                                Padding="8,4"
                                Foreground="#57A7FF"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OpenCoordinatePicker_Click"
                                Content="在高德地图查询坐标 ↗" />
                    </DockPanel>
                    <TextBox x:Name="CoordinatesInput"
                             TextChanged="InputChanged" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="#8291A2"
                               Text="中国大陆使用 GCJ-02，例如 121.51,38.84。" />
                </StackPanel>

                <Border Grid.Row="6"
                        MinHeight="54"
                        Padding="14,11"
                        Background="#172737"
                        BorderBrush="#2A3B4D"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock x:Name="StatusText"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#A4AFBD"
                               Text="请先测试连接；测试成功后才可保存。" />
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Style="{StaticResource ActionButtonStyle}"
                    IsCancel="True"
                    Content="取消" />
            <Button x:Name="TestButton"
                    Margin="12,0,0,0"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="TestButton_Click"
                    Content="测试连接" />
            <Button x:Name="SaveButton"
                    Margin="12,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="False"
                    Click="SaveButton_Click"
                    Content="保存" />
        </StackPanel>
    </Grid>
</Window>
