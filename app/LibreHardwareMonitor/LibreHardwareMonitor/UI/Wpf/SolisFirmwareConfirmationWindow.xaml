<Window x:Class="LibreHardwareMonitor.UI.WpfViews.SolisFirmwareConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认固件更新"
        Width="640"
        Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#101521"
        Foreground="#F5F8FC"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#F5F8FC" />
            <Setter Property="Background" Value="#172737" />
            <Setter Property="BorderBrush" Value="#4B6278" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#168DE2" />
            <Setter Property="BorderBrush" Value="#2CA4F5" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="48"
                    Height="48"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#473510"
                    BorderBrush="#C98B19"
                    BorderThickness="1"
                    CornerRadius="24">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FFC247"
                           Text="!" />
            </Border>
            <StackPanel Grid.Column="1"
                        Margin="8,0,0,0">
                <TextBlock FontSize="28"
                           FontWeight="Bold"
                           Text="确认固件更新" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="14"
                           Foreground="#A4AFBD"
                           Text="确认固件信息后再开始局域网更新。" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Padding="22"
                Background="#111F2C"
                BorderBrush="#2A3B4D"
                BorderThickness="1"
                CornerRadius="12">
            <TextBlock x:Name="FirmwareDetailsText"
                       FontSize="15"
                       LineHeight="25"
                       Foreground="#E7EDF5"
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Style="{StaticResource ActionButtonStyle}"
                    IsCancel="True"
                    Content="取消" />
            <Button Margin="12,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    Click="ConfirmButton_Click"
                    Content="开始更新" />
        </StackPanel>
    </Grid>
</Window>
