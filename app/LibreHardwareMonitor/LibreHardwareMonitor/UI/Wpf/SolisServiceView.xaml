<UserControl
    x:Class="LibreHardwareMonitor.UI.WpfViews.SolisServiceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    FontFamily="Microsoft YaHei UI"
    Foreground="#F4F7FB">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="CardBrush" Color="#0F1D2A" />
            <SolidColorBrush x:Key="InnerCardBrush" Color="#142437" />
            <SolidColorBrush x:Key="BorderBrush" Color="#293C50" />
            <SolidColorBrush x:Key="MutedBrush" Color="#AAB6C5" />
            <SolidColorBrush x:Key="AccentBrush" Color="#57A7FF" />
            <SolidColorBrush x:Key="HealthyBrush" Color="#3ECF8E" />

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="22" />
            </Style>

            <Style x:Key="InnerCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Background" Value="{StaticResource InnerCardBrush}" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#F4F7FB" />
            </Style>

            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            </Style>

            <Style x:Key="StatusStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource HealthyBrush}" />
            </Style>

            <Style x:Key="IconBadgeStyle" TargetType="Border">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Background" Value="#173A59" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>

            <Style x:Key="ExternalIconBadgeStyle" TargetType="Border">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Background" Value="#173A59" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="12" />
            <RowDefinition Height="250" />
            <RowDefinition Height="14" />
            <RowDefinition Height="200" />
            <RowDefinition Height="18" />
            <RowDefinition Height="46" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Top">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="服务" />
                <TextBlock
                    Margin="0,3,0,0"
                    FontSize="12"
                    Style="{StaticResource LabelStyle}"
                    Text="从 PC 后台到副屏，一眼查看整条服务链路。" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Width="22"
                        Height="22"
                        Margin="0,0,8,0"
                        Background="{StaticResource HealthyBrush}"
                        CornerRadius="11">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="#FFFFFF"
                            Symbol="CheckmarkCircle24" />
                    </Border>
                    <TextBlock
                        x:Name="HeaderOverallStatus"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource HealthyBrush}"
                        Text="运行正常" />
                </StackPanel>
                <Border
                    Width="1"
                    Height="32"
                    Margin="26,0"
                    Background="{StaticResource BorderBrush}" />
                <ui:SymbolIcon
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="22"
                    Foreground="{StaticResource MutedBrush}"
                    Symbol="Clock24" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="HeaderLastCommunication"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Text="--" />
                    <TextBlock
                        Margin="0,3,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource LabelStyle}"
                        Text="最近通信" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="服务链路" />
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource InnerCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadgeStyle}">
                                    <ui:SymbolIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="27"
                                        Foreground="{StaticResource AccentBrush}"
                                        Symbol="Desktop24" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="PC 后台" />
                                    <Border
                                        Margin="0,8,0,0"
                                        Padding="9,3"
                                        HorizontalAlignment="Left"
                                        Background="#153A2F"
                                        CornerRadius="5">
                                        <TextBlock Style="{StaticResource StatusStyle}" Text="运行中" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="2">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Solis Monitor" />
                                <TextBlock x:Name="ProcessDetail" Margin="0,6,0,0" Style="{StaticResource LabelStyle}" Text="进程 --" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Ellipse
                            Width="8"
                            Height="8"
                            HorizontalAlignment="Left"
                            Fill="{StaticResource AccentBrush}" />
                        <Border Margin="4,0,0,0" Height="2" Background="{StaticResource AccentBrush}" />
                        <ui:SymbolIcon
                            Margin="0,0,-4,0"
                            HorizontalAlignment="Right"
                            Foreground="{StaticResource AccentBrush}"
                            Symbol="ArrowRight24" />
                    </Grid>

                    <Border Grid.Column="2" Style="{StaticResource InnerCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadgeStyle}">
                                    <ui:SymbolIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="27"
                                        Foreground="#FFFFFF"
                                        Symbol="Globe24" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="设备 API" />
                                    <Border
                                        Margin="0,8,0,0"
                                        Padding="9,3"
                                        HorizontalAlignment="Left"
                                        Background="#153A2F"
                                        CornerRadius="5">
                                        <TextBlock x:Name="ApiStatus" Style="{StaticResource StatusStyle}" Text="正在启动" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="2">
                                <TextBlock
                                    Style="{StaticResource LabelStyle}"
                                    Text="本机与局域网服务" />
                                <TextBlock
                                    x:Name="ApiDetail"
                                    Margin="0,5,0,0"
                                    Style="{StaticResource LabelStyle}"
                                    Text="端口 18472" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="3" VerticalAlignment="Center">
                        <Ellipse
                            Width="8"
                            Height="8"
                            HorizontalAlignment="Left"
                            Fill="{StaticResource AccentBrush}" />
                        <Border Margin="4,0,0,0" Height="2" Background="{StaticResource AccentBrush}" />
                        <ui:SymbolIcon
                            Margin="0,0,-4,0"
                            HorizontalAlignment="Right"
                            Foreground="{StaticResource AccentBrush}"
                            Symbol="ArrowRight24" />
                    </Grid>

                    <Border Grid.Column="4" Style="{StaticResource InnerCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadgeStyle}">
                                    <ui:SymbolIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="27"
                                        Foreground="{StaticResource AccentBrush}"
                                        Symbol="Desktop24" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="当前副屏" />
                                    <Border
                                        Margin="0,8,0,0"
                                        Padding="9,3"
                                        HorizontalAlignment="Left"
                                        Background="#153A2F"
                                        CornerRadius="5">
                                        <TextBlock x:Name="DeviceStatus" Style="{StaticResource StatusStyle}" Text="正在扫描" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                x:Name="DeviceDetail"
                                Grid.Row="2"
                                Style="{StaticResource LabelStyle}"
                                Text="等待设备信息"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="外部采集" />
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="14,8"
                        Cursor="Hand"
                        MouseLeftButtonUp="OpenCodexButton_Click"
                        Style="{StaticResource InnerCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="340" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ExternalIconBadgeStyle}">
                                <Viewbox
                                    Width="24"
                                    Height="24"
                                    Stretch="Uniform">
                                    <ui:SymbolIcon
                                        Width="24"
                                        Height="24"
                                        FontSize="22"
                                        Foreground="{StaticResource AccentBrush}"
                                        Symbol="Code24" />
                                </Viewbox>
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0,10,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Codex 采集" />
                                <Border
                                    Margin="12,0,0,0"
                                    Padding="9,3"
                                    Background="#153A2F"
                                    CornerRadius="5">
                                    <TextBlock x:Name="CodexStatus" Style="{StaticResource StatusStyle}" Text="等待采集" />
                                </Border>
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="采集路径" />
                                <TextBlock
                                    x:Name="CodexDetail"
                                    Margin="0,5,0,0"
                                    Foreground="#DDE6F2"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ui:SymbolIcon
                                Grid.Column="3"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="22"
                                Foreground="{StaticResource MutedBrush}"
                                Symbol="ChevronRight24" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="2"
                        Padding="14,8"
                        Cursor="Hand"
                        MouseLeftButtonUp="EditWeatherButton_Click"
                        Style="{StaticResource InnerCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="340" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ExternalIconBadgeStyle}">
                                <Viewbox
                                    Width="24"
                                    Height="24"
                                    Stretch="Uniform">
                                    <ui:SymbolIcon
                                        Width="24"
                                        Height="24"
                                        FontSize="22"
                                        Foreground="{StaticResource AccentBrush}"
                                        Symbol="WeatherCloudy24" />
                                </Viewbox>
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0,10,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="天气 API" />
                                <Border
                                    Margin="12,0,0,0"
                                    Padding="9,3"
                                    Background="#153A2F"
                                    CornerRadius="5">
                                    <TextBlock x:Name="WeatherStatus" Style="{StaticResource StatusStyle}" Text="等待采集" />
                                </Border>
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="当前位置" />
                                <TextBlock
                                    x:Name="WeatherDetail"
                                    Margin="0,5,0,0"
                                    Foreground="#DDE6F2"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ui:SymbolIcon
                                Grid.Column="3"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="22"
                                Foreground="{StaticResource MutedBrush}"
                                Symbol="ChevronRight24" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border
            Grid.Row="6"
            Padding="0"
            Background="Transparent"
            BorderThickness="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="168" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="168" />
                </Grid.ColumnDefinitions>

                <ui:Button
                    Grid.Column="1"
                    Width="168"
                    Height="46"
                    Background="#1677D2"
                    BorderBrush="#279BFF"
                    Foreground="#FFFFFF"
                    FontSize="14"
                    HorizontalContentAlignment="Center"
                    Appearance="Primary"
                    Click="RestartButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,8,0" FontSize="19" Foreground="#FFFFFF" Symbol="ArrowClockwise24" />
                        <TextBlock x:Name="RestartButtonText" FontSize="14" Foreground="#FFFFFF" Text="重启服务" />
                    </StackPanel>
                </ui:Button>

                <ui:Button
                    Grid.Column="3"
                    Width="168"
                    Height="46"
                    Background="#1C2637"
                    BorderBrush="#3A4C65"
                    Foreground="#F4F7FB"
                    FontSize="14"
                    HorizontalContentAlignment="Center"
                    Appearance="Secondary"
                    Click="CopyDiagnosticsButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,8,0" FontSize="19" Foreground="#F4F7FB" Symbol="DocumentCopy24" />
                        <TextBlock FontSize="14" Foreground="#F4F7FB" Text="复制诊断信息" />
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
