<UserControl
    x:Class="LibreHardwareMonitor.UI.WpfViews.SolisControlCenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LibreHardwareMonitor.UI.WpfViews"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="#101521"
    ClipToBounds="True"
    FontFamily="Microsoft YaHei UI"
    Foreground="#F4F7FB"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <LinearGradientBrush x:Key="CanvasBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#0C1722" />
                <GradientStop Offset="1" Color="#101B27" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#101E2C" />
                <GradientStop Offset="1" Color="#0C1823" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="CardBrush" Color="#111F2C" />
            <SolidColorBrush x:Key="InnerCardBrush" Color="#172737" />
            <SolidColorBrush x:Key="BorderBrush" Color="#2A3B4D" />
            <SolidColorBrush x:Key="MutedBrush" Color="#A4AFBD" />
            <SolidColorBrush x:Key="AccentBrush" Color="#57A7FF" />
            <SolidColorBrush x:Key="HealthyBrush" Color="#3ECF8E" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF6775" />

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="InnerCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Background" Value="{StaticResource InnerCardBrush}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#F4F7FB" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#F4F7FB" />
            </Style>

            <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#F4F7FB" />
            </Style>

            <Style x:Key="MutedStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="52" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="#DDE6F2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#22334A" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#184E78" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="118" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Background" Value="#168DE2" />
                <Setter Property="BorderBrush" Value="#28A4FF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#1EA0F7" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Background" Value="#202A3B" />
                <Setter Property="BorderBrush" Value="#3A4C65" />
                <Setter Property="Foreground" Value="#F4F7FB" />
            </Style>

            <Style x:Key="ToggleStyle" TargetType="CheckBox">
                <Setter Property="Width" Value="52" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border
                                x:Name="Track"
                                Background="#465166"
                                BorderBrush="#59657A"
                                BorderThickness="1"
                                CornerRadius="14">
                                <Ellipse
                                    x:Name="Thumb"
                                    Width="18"
                                    Height="18"
                                    Margin="4"
                                    HorizontalAlignment="Left"
                                    Fill="#FFFFFF" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="#168DE2" />
                                    <Setter TargetName="Track" Property="BorderBrush" Value="#28A4FF" />
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="14,12,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="104" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="52"
                        Height="52"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#132B40"
                        CornerRadius="12">
                        <Image
                            x:Name="BrandImage"
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Solis Monitor" />
                        <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" Text="副屏控制中心" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <Button x:Name="DeviceNavigationButton" Style="{StaticResource NavButtonStyle}" Click="DeviceNavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="22" Foreground="#DCE7F3" Symbol="Desktop24" />
                            <TextBlock Margin="16,0,0,0" FontSize="15" Text="设备" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ServiceNavigationButton" Style="{StaticResource NavButtonStyle}" Click="ServiceNavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="22" Foreground="#DCE7F3" Symbol="Organization24" />
                            <TextBlock Margin="16,0,0,0" FontSize="15" Text="服务" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StartupNavigationButton" Style="{StaticResource NavButtonStyle}" Click="StartupNavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="22" Foreground="#DCE7F3" Symbol="Power24" />
                            <TextBlock Margin="16,0,0,0" FontSize="15" Text="启动与托盘" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FirmwareNavigationButton" Style="{StaticResource NavButtonStyle}" Click="FirmwareNavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="22" Foreground="#DCE7F3" Symbol="ArrowUpload24" />
                            <TextBlock Margin="16,0,0,0" FontSize="15" Text="固件更新" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="DeveloperNavigationButton"
                        Visibility="Collapsed"
                        Style="{StaticResource NavButtonStyle}"
                        Click="DeveloperNavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="20" Foreground="#C9D7E8" Symbol="Code24" />
                            <TextBlock Margin="14,0,0,0" FontSize="14" Text="开发者模式" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock
                    x:Name="VersionText"
                    Grid.Row="2"
                    Padding="4,10"
                    HorizontalAlignment="Center"
                    Cursor="Hand"
                    Foreground="{StaticResource MutedBrush}"
                    MouseLeftButtonUp="VersionText_MouseLeftButtonUp"
                    Text="版本 --"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,12,28,22">
            <Grid x:Name="DevicePage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="120" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="设备" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedStyle}" Text="发现、配对并控制唯一的副屏设备。" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" Background="#173A59" CornerRadius="20">
                            <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Symbol="Desktop24" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="当前设备" />
                            <TextBlock Margin="0,8,20,0" Style="{StaticResource MutedStyle}" Text="副屏与 PC 连接同一局域网后，这里显示连接状态。" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MutedStyle}" Text="设备状态" />
                            <TextBlock x:Name="DeviceStateText" Margin="0,5,0,0" FontSize="13" Text="正在等待局域网发现" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid
                    x:Name="DeviceDetailsGrid"
                    Grid.Row="3"
                    Height="500"
                    VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="连接与安全" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingTitleStyle}" Text="设备向导" />
                                    <TextBlock Margin="0,4,12,0" Style="{StaticResource MutedStyle}" Text="配置 Wi-Fi、发现并配对副屏" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Click="DeviceWizardButton_Click" Content="设备向导" />
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingTitleStyle}" Text="安全配对" />
                                    <TextBlock Margin="0,4,12,0" Style="{StaticResource MutedStyle}" Text="令牌由配对流程自动同步" />
                                </StackPanel>
                                <TextBlock x:Name="PairingStatusText" Grid.Column="1" VerticalAlignment="Center" FontSize="13" Text="尚未配对" />
                            </Grid>

                            <Grid x:Name="ClearPairingRow" Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingTitleStyle}" Text="清除配对" />
                                    <TextBlock Margin="0,4,12,0" Style="{StaticResource MutedStyle}" Text="清除本地令牌；重连需再次输入 6 位配对码" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Click="ClearPairingButton_Click" Content="清除配对" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="显示与电源" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingTitleStyle}" Text="亮度" />
                                    <TextBlock Margin="0,4,12,0" Style="{StaticResource MutedStyle}" Text="拖动后自动保存" />
                                </StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        x:Name="BrightnessSlider"
                                        Minimum="10"
                                        Maximum="100"
                                        ValueChanged="BrightnessSlider_ValueChanged" />
                                    <TextBlock x:Name="BrightnessValueText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="--" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingTitleStyle}" Text="夜间背光" />
                                    <TextBlock x:Name="NightBacklightSummaryText" Margin="0,4,12,0" Style="{StaticResource MutedStyle}" Text="设置关闭背光的时间范围" />
                                </StackPanel>
                                <Button x:Name="NightBacklightButton" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Click="NightBacklightButton_Click" Content="设置" />
                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingTitleStyle}" Text="远程重启" />
                                    <TextBlock Margin="0,4,12,0" Style="{StaticResource MutedStyle}" Text="仅重启副屏，不影响 PC 后台服务" />
                                </StackPanel>
                                <Button x:Name="RestartDeviceButton" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Click="RestartDeviceButton_Click" Content="重新启动" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <local:SolisServiceView x:Name="ServicePage" Visibility="Collapsed" />

            <Grid x:Name="StartupPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="120" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="250" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="70" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="启动与托盘" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedStyle}" Text="控制 Solis Monitor 如何随 Windows 启动。" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" Background="#173A59" CornerRadius="20">
                            <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Symbol="Play24" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="后台运行" />
                            <TextBlock Margin="0,8,20,0" Style="{StaticResource MutedStyle}" Text="关闭或最小化窗口后继续采集并向副屏提供数据。" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MutedStyle}" Text="当前策略" />
                            <TextBlock x:Name="StartupSummaryText" Margin="0,5,0,0" FontSize="13" Text="正在读取启动策略" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Windows 启动" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleStyle}" Text="静默启动" />
                                <TextBlock Margin="0,5,20,0" Style="{StaticResource MutedStyle}" Text="只影响 Windows 开机自动启动；手动打开仍显示控制台" />
                            </StackPanel>
                            <CheckBox x:Name="SilentStartupToggle" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleStyle}" Click="SilentStartupToggle_Click" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleStyle}" Text="开机启动" />
                                <TextBlock Margin="0,5,20,0" Style="{StaticResource MutedStyle}" Text="使用最高权限计划任务，首次启用需要管理员授权" />
                            </StackPanel>
                            <CheckBox x:Name="AutoStartToggle" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleStyle}" Click="AutoStartToggle_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="5" Padding="16,12" Style="{StaticResource CardStyle}">
                    <TextBlock Style="{StaticResource MutedStyle}" Text="关闭或最小化窗口时，Solis Monitor 会隐藏到托盘。需要完全退出时，请使用托盘菜单中的“退出”。" />
                </Border>
            </Grid>

            <Grid x:Name="FirmwarePage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="120" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="220" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="固件更新" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedStyle}" Text="副屏只接电源时，也可以通过局域网完成维护。" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" Background="#173A59" CornerRadius="20">
                            <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Symbol="ArrowUpload24" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="本地 OTA" />
                            <TextBlock Margin="0,8,20,0" Style="{StaticResource MutedStyle}" Text="只接受 Solis Monitor 的 ESP32-S3 固件；更新失败时保留或回滚旧版本。" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MutedStyle}" Text="更新状态" />
                            <TextBlock x:Name="FirmwareStatusText" Margin="0,5,0,0" FontSize="13" Text="尚未选择固件" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="更新来源" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleStyle}" Text="本地固件" />
                                <TextBlock Margin="0,5,20,0" Style="{StaticResource MutedStyle}" Text="选择 .bin 文件后先校验芯片、项目、版本和 SHA-256" />
                            </StackPanel>
                            <Button x:Name="FirmwareSelectButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Click="FirmwareSelectButton_Click" Content="选择固件" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleStyle}" Text="更新进度" />
                                <TextBlock Margin="0,5,20,0" Style="{StaticResource MutedStyle}" Text="上传完成后等待副屏重启并确认实际运行版本" />
                            </StackPanel>
                            <ProgressBar x:Name="FirmwareProgressBar" Grid.Column="1" Height="8" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="DeveloperPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="120" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="190" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="开发者模式" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedStyle}" Text="查看完整的 LibreHardwareMonitor 传感器树和高级菜单。" />
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" Background="#173A59" CornerRadius="20">
                            <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Symbol="Code24" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="开发者入口" />
                            <TextBlock Margin="0,7,0,0" Foreground="{StaticResource HealthyBrush}" Text="已解锁 · 高级功能可用" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleStyle}" Text="完整传感器树" />
                                <TextBlock Margin="0,5,20,0" Style="{StaticResource MutedStyle}" Text="打开原始硬件树、传感器菜单和高级设置" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Click="EnterDeveloperButton_Click" Content="进入模式" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleStyle}" Text="关闭开发者入口" />
                                <TextBlock Margin="0,5,20,0" Style="{StaticResource MutedStyle}" Text="关闭后隐藏本页，需要再次点击版本号 10 次" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Click="DisableDeveloperButton_Click" Content="关闭入口" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
