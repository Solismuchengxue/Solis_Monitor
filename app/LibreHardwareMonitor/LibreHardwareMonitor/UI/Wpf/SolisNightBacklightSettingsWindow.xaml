<Window x:Class="LibreHardwareMonitor.UI.WpfViews.SolisNightBacklightSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="夜间背光"
        Width="560"
        Height="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#101521"
        Foreground="#F5F8FC"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                         Color="#172737" />
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="136" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#F5F8FC" />
            <Setter Property="Background" Value="#172737" />
            <Setter Property="BorderBrush" Value="#4B6278" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#168DE2" />
            <Setter Property="BorderBrush" Value="#2CA4F5" />
        </Style>
        <Style x:Key="TimeComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#172737" />
            <Setter Property="Foreground" Value="#F5F8FC" />
            <Setter Property="BorderBrush" Value="#4B6278" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="30"
                       FontWeight="Bold"
                       Text="夜间背光" />
            <TextBlock Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#A4AFBD"
                       Text="副屏按本地时间自动关闭背光，跨越午夜的时段也可保存。" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="22"
                Background="#111F2C"
                BorderBrush="#2A3B4D"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <CheckBox x:Name="NightEnabledInput"
                          FontSize="16"
                          VerticalContentAlignment="Center"
                          Content="启用夜间背光" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Margin="0,0,0,7"
                                   HorizontalAlignment="Center"
                                   Foreground="#A4AFBD"
                                   Text="开始" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="StartHourInput"
                                      Style="{StaticResource TimeComboBoxStyle}" />
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Text=":" />
                            <ComboBox x:Name="StartMinuteInput"
                                      Grid.Column="2"
                                      Style="{StaticResource TimeComboBoxStyle}" />
                        </Grid>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,11"
                               Foreground="#A4AFBD"
                               Text="–" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,7"
                                   HorizontalAlignment="Center"
                                   Foreground="#A4AFBD"
                                   Text="结束" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="EndHourInput"
                                      Style="{StaticResource TimeComboBoxStyle}" />
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Text=":" />
                            <ComboBox x:Name="EndMinuteInput"
                                      Grid.Column="2"
                                      Style="{StaticResource TimeComboBoxStyle}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ValidationText"
                           Grid.Row="3"
                           Margin="0,14,0,0"
                           Foreground="#FF6B78"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Style="{StaticResource ActionButtonStyle}"
                    IsCancel="True"
                    Content="取消" />
            <Button Margin="12,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click"
                    Content="保存设置" />
        </StackPanel>
    </Grid>
</Window>
